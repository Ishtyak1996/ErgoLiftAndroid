<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101720">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ErgoLift  •  Live posture"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp" />
        <Button
            android:id="@+id/switchCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flip camera" />
    </LinearLayout>

    <!-- FIT_CENTER preserves the entire camera frame rather than cropping it. -->
    <ImageView
        android:id="@+id/liveImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:scaleType="fitCenter"
        android:contentDescription="Live camera with skeleton overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/postureText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="WAITING FOR CAMERA"
            android:textColor="#D6DCE2"
            android:textStyle="bold"
            android:textSize="19sp" />
        <Button
            android:id="@+id/calibrateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calibrate neck" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="185dp"
        android:fillViewport="true"
        android:background="#19232E">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:id="@+id/anglesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9DEADF"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp"
                android:text="Trunk: --  •  Neck: --\nLeft elbow: --  •  Right elbow: --" />
            <TextView
                android:id="@+id/phaseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:text="Phase: NOT DETECTED" />
            <TextView
                android:id="@+id/detailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#C3CDD7"
                android:textSize="13sp"
                android:text="Side-on view needed. Keep head, shoulders and hips visible." />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#9CA9B5"
                android:textSize="11sp"
                android:text="EXPERIMENTAL DEMO — not a validated lifting-safety assessment." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
